<UserControl x:Class="MetadataImageOptimizer.Views.QualitySettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:MetadataImageOptimizer.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DataContext="{d:DesignInstance local:MetadataImageOptimizerSettingsViewModel}"
  d:DesignWidth="600"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style.Setters>
    </Style>
    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
      <Style.Setters>
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style.Setters>
    </Style>
  </UserControl.Resources>
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
      Grid.Column="0"
      Margin="0,0,20,0"
      Text="JPG Quality:" />
    <TextBox Grid.Row="0"
      Grid.Column="1"
      MinWidth="50"
      Margin="0,0,10,0"
      Text="{Binding Settings.Quality.JpgQuality}" />
    <TextBlock Grid.Row="0"
      Grid.Column="2"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Defines the quality of converted JPG images. 1 (worst) to 100 (best). Defaults to 90" />

    <TextBlock Grid.Row="1"
      Grid.Column="0"
      Margin="0,10,20,0"
      Text="PNG Compression Level:" />
    <ComboBox Grid.Row="1"
      Grid.Column="1"
      MinWidth="100"
      Margin="0,10,10,0"
      DisplayMemberPath="Value"
      ItemsSource="{Binding Settings.Quality.AvailablePngCompressionLevels}"
      SelectedValue="{Binding Settings.Quality.PngCompressionLevel}"
      SelectedValuePath="Key" />

    <TextBlock Grid.Row="2"
      Grid.Column="0"
      Margin="0,10,20,0"
      Text="WebP Encoding Method:" />
    <ComboBox Grid.Row="2"
      Grid.Column="1"
      MinWidth="100"
      Margin="0,10,10,0"
      DisplayMemberPath="Value"
      ItemsSource="{Binding Settings.Quality.AvailableWebpEncodingMethods}"
      SelectedValue="{Binding Settings.Quality.WebpEncodingMethod}"
      SelectedValuePath="Key" />
    <TextBlock Grid.Row="2"
      Grid.Column="2"
      Margin="0,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Defines the method used when encoding WebP images. Slower methods take longer but generate smaller/better images." />

    <TextBlock Grid.Row="3"
      Grid.Column="0"
      Margin="0,10,20,0"
      Text="WebP Quality:" />
    <TextBox Grid.Row="3"
      Grid.Column="1"
      MinWidth="50"
      Margin="0,10,10,0"
      Text="{Binding Settings.Quality.WebpQuality}" />
    <TextBlock Grid.Row="3"
      Grid.Column="2"
      Margin="0,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Defines the compression quality of converted WebP images. 0 (worst) to 100 (best). Defaults to 90" />

    <TextBlock Grid.Row="4"
      Grid.Column="0"
      Margin="0,10,20,0"
      Text="JPEG XL Quality:" />
    <TextBox Grid.Row="4"
      Grid.Column="1"
      MinWidth="50"
      Margin="0,10,10,0"
      Text="{Binding Settings.Quality.JxlQuality}">
      <TextBox.Style>
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Settings.Quality.JxlLossless}" Value="True">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBox.Style>
    </TextBox>
    <TextBlock Grid.Row="4"
      Grid.Column="2"
      Margin="0,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Defines the compression quality of converted JPEG XL images. 1 (worst) to 100 (lossless). Defaults to 90. Images are encoded with the bundled cjxl encoder." />

    <CheckBox Grid.Row="5"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,10,0,0"
      Content="JPEG XL lossless (ignores the quality above, files get larger)"
      IsChecked="{Binding Settings.Quality.JxlLossless}" />
    <TextBlock Grid.Row="5"
      Grid.Column="2"
      Margin="10,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Encodes JPEG XL mathematically losslessly (cjxl --distance=0) instead of using a quality value. A configured target size can no longer be reached by lowering the quality." />

    <TextBlock Grid.Row="6"
      Grid.Column="0"
      Margin="0,10,20,0"
      Text="JPEG XL Effort:" />
    <TextBox Grid.Row="6"
      Grid.Column="1"
      MinWidth="50"
      Margin="0,10,10,0"
      Text="{Binding Settings.Quality.JxlEffort}" />
    <TextBlock Grid.Row="6"
      Grid.Column="2"
      Margin="0,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="cjxl encoder effort, 1 (fastest) to 11 (smallest files). 11 is an expert mode that is roughly ten times slower and can take several minutes per image for a few percent smaller lossless files. Defaults to 7." />

    <TextBlock Grid.Row="7"
      Grid.Column="0"
      Margin="0,10,20,0"
      Text="JPEG XL Brotli effort:" />
    <TextBox Grid.Row="7"
      Grid.Column="1"
      MinWidth="50"
      Margin="0,10,10,0"
      Text="{Binding Settings.Quality.JxlBrotliEffort}" />
    <TextBlock Grid.Row="7"
      Grid.Column="2"
      Margin="0,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Brotli effort for the metadata boxes (colour profile, EXIF, XMP), 0 to 11. Only affects images whose metadata is kept, so it does nothing when metadata is removed. Defaults to 9." />

    <CheckBox Grid.Row="8"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,15,0,0"
      Content="Remove metadata (EXIF, IPTC, XMP)"
      IsChecked="{Binding Settings.Quality.StripMetadata}" />
    <TextBlock Grid.Row="8"
      Grid.Column="2"
      Margin="10,15,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Removes camera information, GPS location, creation date and other embedded metadata from optimized images. The colour profile is kept." />

    <CheckBox Grid.Row="9"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,10,0,0"
      Content="Keep the original if the result is larger"
      IsChecked="{Binding Settings.Quality.SkipIfLarger}" />
    <TextBlock Grid.Row="9"
      Grid.Column="2"
      Margin="10,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Prevents an image from being replaced by a bigger file, which can happen when re-compressing an already optimized image. Images that are resized are always written." />

    <CheckBox Grid.Row="10"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,10,0,0"
      Content="Optimize PNG losslessly with oxipng"
      IsChecked="{Binding Settings.Quality.PngUseOxipng}" />
    <TextBlock Grid.Row="10"
      Grid.Column="2"
      Margin="10,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Re-encodes PNG output with the bundled oxipng. It changes filters, colour type and palette without changing any pixel, so the result stays lossless. The optimized file is only used when it is smaller." />

    <CheckBox Grid.Row="11"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,10,0,0"
      Content="Use Zopfli for PNG (slowest, slightly smaller)"
      IsChecked="{Binding Settings.Quality.PngUseZopfli}">
      <CheckBox.Style>
        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Settings.Quality.PngUseOxipng}" Value="False">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </CheckBox.Style>
    </CheckBox>
    <TextBlock Grid.Row="11"
      Grid.Column="2"
      Margin="10,10,0,0"
      FontFamily="{DynamicResource FontIcoFont}"
      Text="&#xefca;"
      ToolTip="Uses Zopfli instead of the default deflate implementation. It produces slightly smaller PNG files and takes roughly ten times longer. Requires the oxipng option above." />
  </Grid>
</UserControl>